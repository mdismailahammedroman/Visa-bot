<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP Verification</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial,
          sans-serif;
      }

      .container {
        width: 100%;
        padding: 40px 15px;
      }

      .card {
        max-width: 520px;
        margin: auto;
        background: #ffffff;
        border-radius: 16px;
        padding: 36px 32px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        text-align: center;
      }

      .logo {
        font-size: 22px;
        font-weight: 700;
        color: #2563eb;
        margin-bottom: 10px;
      }

      h2 {
        margin: 10px 0 16px;
        font-size: 24px;
        color: #111827;
      }

      p {
        font-size: 15px;
        color: #4b5563;
        line-height: 1.6;
        margin: 8px 0;
      }

      .otp-box {
        margin: 28px auto;
        padding: 18px 24px;
        border-radius: 12px;
        background: linear-gradient(135deg, #eff6ff, #eef2ff);
        border: 1px dashed #2563eb;
        display: inline-block;
      }

      .otp {
        font-size: 34px;
        letter-spacing: 6px;
        font-weight: 700;
        color: #2563eb;
      }

      .expiry {
        margin-top: 16px;
        font-size: 14px;
        color: #374151;
      }

      .warning {
        margin-top: 20px;
        font-size: 13px;
        color: #6b7280;
      }

      .divider {
        height: 1px;
        background: #e5e7eb;
        margin: 30px 0 20px;
      }

      .footer {
        font-size: 12px;
        color: #9ca3af;
      }

      @media (max-width: 480px) {
        .card {
          padding: 28px 20px;
        }
        .otp {
          font-size: 30px;
          letter-spacing: 4px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <div class="logo">{{appName}}</div>

        <h2>Hello {{name}} 👋</h2>

        <p>{{description}}</p>

        <div class="otp-box">
          <div class="otp">{{otp}}</div>
        </div>

        <div class="expiry">
          ⏳ This code expires in
          <strong>{{expiry}} minutes</strong>
        </div>

        <p class="warning">
          If you didn’t request this code, you can safely ignore this email.
        </p>

        <div class="divider"></div>

        <div class="footer">
          ©
          {{year}}
          {{appName}}
          · All rights reserved
        </div>
      </div>
    </div>
  </body>
</html>